# Production Environment Variables for NOVA BLOCKS Backend
# Copy this file to .env and update with your production values

NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb://mongo:27017/novablocks
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
ALLOWED_ORIGINS=https://your-production-domain.com,http://localhost:3000

# API Keys for external services (if needed)
# API_KEY=your-api-key-here

# Logging Configuration
LOG_LEVEL=warning  #: debug, info, warning, error, fatal
# LOG_FILE=/var/log/nova-blocks/nova-blocks.log  #: Optional file path for file transport

# GPU Configuration
GPU_ENABLED=false  #: Set true if NVIDIA Blackwell GPU is detected

# Security
APP_NAME=nova-blocks
X_POWERED_BY_DISABLED=true  #: Set to true to disable x-powered-by header

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  #: 15 minutes in milliseconds
RATE_LIMIT_MAX=100  #: Max requests per window